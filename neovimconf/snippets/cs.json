{
  "if statement": {
    "prefix": "if",
    "body": [
      "if (${1:true}) {",
      "  $0",
      "}"
    ],
    "description": "if statement with same-line brace"
  },
  "else-if statement": {
    "prefix": "else if",
    "body": [
      "else if (${1:true}) {",
      "  $0",
      "}"
    ],
    "description": "else-if statement with same-line brace"
  },
  "Else statement": {
    "prefix": "else",
    "body": [
      "else {",
      "  $0",
      "}"
    ],
    "description": "Else statement with same-line brace"
  },
  "for loop": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:length}; ${1:i}++) {",
      "  $0",
      "}"
    ],
    "description": "for loop with same-line brace"
  },
  "Reverse for loop": {
    "prefix": "forr",
    "body": [
      "for (int ${1:i} = ${2:length} - 1; ${1:i} >= 0; ${1:i}--) {",
      "  $0",
      "}"
    ],
    "description": "Reverse for loop with same-line brace"
  },
  "Foreach statement": {
    "prefix": "foreach",
    "body": [
      "foreach (${1:var} ${2:item} in ${3:collection}) {",
      "  $0",
      "}"
    ],
    "description": "Foreach statement with same-line brace"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while (${1:true}) {",
      "  $0",
      "}"
    ],
    "description": "While loop with same-line brace"
  },
  "do...while loop": {
    "prefix": "do",
    "body": [
      "do {",
      "  $0",
      "} while (${1:true});"
    ],
    "description": "do...while loop with same-line brace"
  },
  "Switch statement": {
    "prefix": "switch",
    "body": [
      "switch (${1:switch_on}) {",
      "  case ${2:value}:",
      "      $0",
      "      break;",
      "  default:",
      "      break;",
      "}"
    ],
    "description": "Switch statement with same-line brace"
  },
  "Try catch": {
    "prefix": "try",
    "body": [
      "try {",
      "  $1",
      "} catch (${2:Exception} ${3:ex}) {",
      "  $0",
      "}"
    ],
    "description": "Try catch with same-line brace"
  },
  "Try finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "  $1",
      "} finally {",
      "  $0",
      "}"
    ],
    "description": "Try finally with same-line brace"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "${1:public} class ${2:Name} {",
      "  $0",
      "}"
    ],
    "description": "Class with same-line brace"
  },
  "cls": {
    "prefix": "cls",
    "body": [
      "${1:public} class ${2:$TM_FILENAME_BASE} {",
      "  $0",
      "}"
    ],
    "description": "Create new class with same-line brace"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "${1:public} interface I${2:Name} {",
      "  $0",
      "}"
    ],
    "description": "Interface with same-line brace"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "${1:public} struct ${2:Name} {",
      "  $0",
      "}"
    ],
    "description": "Struct with same-line brace"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "${1:public} enum ${2:Name} {",
      "  $0",
      "}"
    ],
    "description": "Enum with same-line brace"
  },
  "constructor": {
    "prefix": "ctor",
    "body": [
      "${1:public} ${2:$TM_FILENAME_BASE}(${3:Parameters}) {",
      "  $0",
      "}"
    ],
    "description": "Constructor with same-line brace"
  },
  "Creates a Method structure": {
    "prefix": "method",
    "body": [
      "${1:public} ${2:void} ${3:MyMethod}(${4:Parameters}) {",
      "  $0",
      "}"
    ],
    "description": "Method with same-line brace"
  },
  "Creates an Async Method structure": {
    "prefix": "method_async",
    "body": [
      "${1:public} async Task<${2:void}> ${3:MyMethodAsync}(${4:Parameters}) {",
      "  $0",
      "}"
    ],
    "description": "Async Method with same-line brace"
  },
  "Lock statement": {
    "prefix": "lock",
    "body": [
      "lock (${1:this}) {",
      "  $0",
      "}"
    ],
    "description": "Lock statement with same-line brace"
  },
  "Using statement": {
    "prefix": "using",
    "body": [
      "using (${1:resource}) {",
      "  $0",
      "}"
    ],
    "description": "Using statement with same-line brace"
  },
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:Name} {",
      "  $0",
      "}"
    ],
    "description": "Namespace with same-line brace"
  }
}
